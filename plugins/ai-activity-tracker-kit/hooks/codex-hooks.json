{
  "hooks": {
    "SessionStart": [
      { "hooks": [
        { "type": "command", "command": "bash \"${PLUGIN_ROOT}/hooks/load-context.sh\"" },
        { "type": "command", "command": "python3 \"${PLUGIN_ROOT}/scripts/ts.py\" hook --source codex", "timeout": 5 }
      ] }
    ],
    "UserPromptSubmit": [
      { "hooks": [ { "type": "command", "command": "python3 \"${PLUGIN_ROOT}/scripts/ts.py\" hook --source codex", "timeout": 5 } ] }
    ],
    "PostToolUse": [
      { "hooks": [ { "type": "command", "command": "python3 \"${PLUGIN_ROOT}/scripts/ts.py\" hook --source codex", "timeout": 5 } ] }
    ],
    "Stop": [
      { "hooks": [ { "type": "command", "command": "python3 \"${PLUGIN_ROOT}/scripts/ts.py\" hook --source codex", "timeout": 5 } ] }
    ],
    "SessionEnd": [
      { "hooks": [ { "type": "command", "command": "python3 \"${PLUGIN_ROOT}/hooks/auto-snapshot.py\"", "timeout": 3 } ] }
    ]
  }
}
